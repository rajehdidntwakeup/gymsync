# Database (local/CI/prod)
DB_URL=jdbc:postgresql://localhost:5432/gymsync
DB_USERNAME=postgres
DB_PASSWORD=password

# JWT
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes

# Spring profile: h2 (local no PostgreSQL), prod (Docker/compose)
SPRING_PROFILES_ACTIVE=h2

# Warning: never commit real secrets.